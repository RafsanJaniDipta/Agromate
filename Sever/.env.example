# ---- Runtime ----
NODE_ENV=development
PORT=5000

# ---- Database (Sondip) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agromate?schema=public"

# ---- Auth: Better Auth (Masud) ----
# Session cookies, so BETTER_AUTH_SECRET must be >= 32 chars with high entropy.
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET="replace-me-with-output-of-openssl-rand-base64-48"
# Base URL of THIS api (the server that owns the auth routes), not the Next.js client.
BETTER_AUTH_URL=http://localhost:5000
# Must match the Next.js client origin so the session cookie is accepted.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Session lifetime in seconds (default 7 days).
SESSION_EXPIRES_IN=604800
SESSION_UPDATE_AGE=86400

# ---- CORS: comma-separated list of allowed origins (Masud) ----
CLIENT_URL=http://localhost:3000

# ---- AI provider (Irfan) ----
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=30000

# ---- External APIs (Irfan) ----
WEATHER_API_KEY=
MARKET_API_KEY=

# ---- Seed accounts (Sondip) ----
SEED_ADMIN_EMAIL=admin@agromate.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_EXPERT_EMAIL=expert@agromate.dev
SEED_EXPERT_PASSWORD=Expert@12345
SEED_FARMER_EMAIL=farmer@agromate.dev
SEED_FARMER_PASSWORD=Farmer@12345